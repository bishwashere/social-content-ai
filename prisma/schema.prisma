generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                               String    @id @default(auto()) @map("_id") @db.ObjectId
  email                            String    @unique
  password                         String?
  avatarUrl                        String
  name                             String
  idFromProvider                   String
  remainingChatGenerations         Int       @default(100)
  dashboardChatSessionsUsed        Int       @default(0)
  hasClaimedFreeTrial              Boolean   @default(false)
  freeCreditsCongratsShown         Boolean   @default(false)
  demoCampaignCreated              Boolean   @default(false)
  lastInformedAboutInactiveProject DateTime? @default(now())
  guidedTourEnabled                Boolean   @default(true)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  projects          Projects[]
  invitedProjects   InvitedUser[]
  oauthProviders    OauthProvider[]
  subscriptions     Subscription[]
  walls             Wall[]
  firstViewTooltips FirstViewTooltip[]
  uploadedVideos    UploadedVideo[]
  projectFolders    ProjectFolder[]
  referralSignup    ReferralSignup?
  ideas             Idea[]
  newsPreferences   UserNewsPreferences?
  featureRequests   FeatureRequest[]

  @@map("users")
}

model Projects {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  url          String?
  description  String   @default("")
  userId       String   @db.ObjectId
  platformUrls Json     @default("{}") // Map<string, string> → JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                    User?                    @relation(fields: [userId], references: [id])
  campaignPlanners        CampaignPlanner[]
  invitedUsers            InvitedUser[]
  projectChats            ProjectChat[]
  projectTrackings        ProjectTracking[]
  walls                   Wall[]
  uploadedVideos          UploadedVideo[]
  ProjectsSubredditData   ProjectsSubredditData[]
  projectToOAuthProviders ProjectToOAuthProvider[]
  scheduledPosts          ScheduledPost[]
  pulseMetrics            ProjectPulse[]
  projectFolderItems      ProjectFolderItem[]
  analytics               ProjectAnalytics[]

  @@map("projects")
}

model InvitedUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  userId    String   @db.ObjectId
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Projects @relation(fields: [projectId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@map("invited-users-to-projects")
}

model ProjectChat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  title     String
  prompt    String   @default("")
  contents  Json     @default("{}") // Map<string, string> → JSON
  media     Json?    // Map<string, string> → JSON for platform media (e.g. instagram text card images)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Projects? @relation(fields: [projectId], references: [id])

  @@map("project-chats")
}

model ProjectTracking {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  date      DateTime
  url       String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Projects? @relation(fields: [projectId], references: [id])

  @@map("project-trackings")
}

model CampaignPlanner {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String         @db.ObjectId
  goal              String
  targetAudience    String
  name              String?
  startDate         DateTime?
  platforms         String[]       @default(["twitter", "linkedin", "instagram", "facebook", "threads", "reddit", "tiktok"])
  autoPostEnabled   Boolean        @default(false)
  autoPostTime      String?
  autoPostPlatforms String[]
  blogNewsMetadata  Json? // Store Blog News metadata (topics, angles, webhook) at campaign level
  totalDays         Int? // Total number of days in the campaign (calculated from chats)
  repeatNextMonth   Boolean        @default(false)
  chats             CampaignChat[] @relation("PlannerChats")
  analytics         CampaignAnalytics[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  project Projects? @relation(fields: [projectId], references: [id])

  @@map("campaign-planners")
}

enum Status {
  PENDING
  GENERATED
}

model CampaignChat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  plannerId String   @db.ObjectId
  title     String?
  prompt    String   @default("")
  day       Int
  completed Boolean  @default(false)
  contents  Json     @default("{}") // Map<string, string> -> JSON
  tickMark  Json     @default("{}") // Map<string, string> -> JSON
  media     Json     @default("{}") // Map<string, string> -> JSON (platform -> S3 key)
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subreddit            String?
  referencePostContent String?

  planner CampaignPlanner? @relation("PlannerChats", fields: [plannerId], references: [id], onDelete: Cascade)
}

enum OauthPlatform {
  facebook
  twitter
  linkedin
  instagram
  threads
  reddit
  tiktok
}

model OauthProvider {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  platform         OauthPlatform
  accessToken      String
  refreshToken     String?
  expiresAt        Int?
  pageId           String?
  pageName         String?
  pageProfilePhoto String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  isStandalone     Boolean       @default(false)
  pageFollowers    Int           @default(0)

  user                    User?                    @relation(fields: [userId], references: [id])
  projectToOAuthProviders ProjectToOAuthProvider[]
  scheduledPosts          ScheduledPost[]
  pagePosts               PlatformPost[]

  @@unique([userId, pageId, platform])
  @@map("oauth-providers")
}

model ProjectToOAuthProvider {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String   @db.ObjectId
  oauthProviderId String   @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project       Projects?      @relation(fields: [projectId], references: [id])
  oauthProvider OauthProvider? @relation(fields: [oauthProviderId], references: [id])

  @@map("project-to-oauth-providers")
}

model ScheduledPost {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String    @db.ObjectId
  oauthProviderId String?   @db.ObjectId
  platform        String
  content         String
  date            DateTime
  status          String    @default("pending")
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  processedAt     DateTime?

  media String? // S3 key or URL for uploaded media (image/video)

  project       Projects?      @relation(fields: [projectId], references: [id])
  oauthProvider OauthProvider? @relation(fields: [oauthProviderId], references: [id])
  meta          Json? // any details that can be stored 

  @@map("scheduled-posts")
}

model Subscription {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String   @db.ObjectId
  startedAt                DateTime
  endsAt                   DateTime
  invoiceId                String   @default("")
  status                   String
  subscriptionIdFromStripe String   @default("")
  customerId               String   @default("")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  active                   Boolean?

  user User? @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model Wall {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  platform  String
  projectId String   @db.ObjectId
  prompt    String   @default("")
  content   String
  views     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?     @relation(fields: [userId], references: [id])
  project Projects? @relation(fields: [projectId], references: [id])

  @@map("wall")
}

model FirstViewTooltip {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String   @db.ObjectId
  addProject              Boolean  @default(false)
  contentPlanner          Boolean  @default(false)
  quickGenerate           Boolean  @default(false)
  videoGeneration         Boolean  @default(false)
  platformIconsOnboarding Boolean  @default(false)
  dismissedProjectAlerts  String[] @default([])
  approvedAutoLinks       Json     @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("first-view-tooltip")
}

model UploadedVideo {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  projectId         String?  @db.ObjectId
  campaignPlannerId String?  @db.ObjectId
  folderId          String
  text              String
  day               Int?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isPublised        Boolean  @default(false)

  user    User?     @relation(fields: [userId], references: [id])
  project Projects? @relation(fields: [projectId], references: [id])

  @@map("uploaded-videos")
}

model ProjectsSubredditData {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  subreddit String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Projects? @relation(fields: [projectId], references: [id])

  @@map("projects-subreddit-data")
}

model SubredditPopularPosts {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  subreddit String
  posts     Json

  @@map("subreddit-popular-posts")
}

model PlatformPost {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  postId            String
  oauthProviderId   String   @db.ObjectId
  date              DateTime
  content           String?
  likes             Int
  comments          Int
  shares            Int      @default(0)
  impressions       Int?
  uniqueImpressions Int?
  media             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthProvider OauthProvider @relation(fields: [oauthProviderId], references: [id], onDelete: Cascade)
  insights      PostInsights?
}

model PostInsights {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  platformPostId String @unique @db.ObjectId

  // Post metadata (optional fields - only for platforms that provide them)
  postType       String? // "photo", "video", "link", "status"
  story          String?
  permalinkUrl   String?
  fullPictureUrl String?
  linkUrl        String?

  // Reaction breakdowns (optional - only if platform provides them)
  reactionsLike  Int? @default(0)
  reactionsLove  Int? @default(0)
  reactionsWow   Int? @default(0)
  reactionsHaha  Int? @default(0)
  reactionsSorry Int? @default(0)
  reactionsAnger Int? @default(0)

  // Advanced metrics (optional - may require separate API calls)
  postReach        Int? // Different from impressions_unique
  engagedUsers     Int?
  postClicks       Int?
  negativeFeedback Int?

  // Metadata
  insightsFetchedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  platformPost PlatformPost @relation(fields: [platformPostId], references: [id], onDelete: Cascade)

  @@map("post-insights")
}

model ProjectPulse {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  pulse                 Float
  components            Json
  thisWeekPostSummaries Json
  daysPosted            Int
  gapDays               Int
  projectId             String   @db.ObjectId
  createdAt             DateTime @default(now())

  project Projects @relation(fields: [projectId], references: [id])

  @@map("project-pulse")
}

model ProjectFolder {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  userId      String   @db.ObjectId
  color       String?  @default("#3B82F6") // Default blue color
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User?               @relation(fields: [userId], references: [id])
  projectFolderItems ProjectFolderItem[]

  @@map("project-folders")
}

model ProjectFolderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  folderId  String   @db.ObjectId
  projectId String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder  ProjectFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project Projects      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([folderId, projectId])
  @@map("project-folder-items")
}

model ReferralPartner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  username  String   @unique
  password  String // Hashed password
  code      String   @unique // Unique referral code for URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks  ReferralClick[]
  signups ReferralSignup[]

  @@map("referral-partners")
}

model ReferralClick {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  referralPartnerId String   @db.ObjectId
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  referralPartner ReferralPartner @relation(fields: [referralPartnerId], references: [id], onDelete: Cascade)

  @@map("referral-clicks")
}

model ReferralSignup {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  referralPartnerId String   @db.ObjectId
  userId            String   @db.ObjectId
  createdAt         DateTime @default(now())

  referralPartner ReferralPartner @relation(fields: [referralPartnerId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId]) // A user can only sign up once through a referral
  @@map("referral-signups")
}

enum TemplateCategory {
  ALL
  TIP
  CASE_STUDY
  STORY
  HOW_TO
  QUESTION
  OPINION
  LIST
  BEHIND_THE_SCENES
  HUMOR
}

model Template {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  category     TemplateCategory
  content      String // Template content with {{placeholders}}
  icon         String? // Icon name or identifier
  source       String?
  sourcePostId String?
  impressions  Int?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("templates")
}

enum IdeaStatus {
  draft
  published
}

model Idea {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  slug        String     @unique
  title       String
  summary     String
  content     String // Raw MDX/Markdown content
  tags        String[]   @default([])
  thumbnail   String?
  status      IdeaStatus @default(draft)
  publishedAt DateTime?
  authorId    String     @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User? @relation(fields: [authorId], references: [id])

  @@map("ideas")
}

model GeminiApiKeyState {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  keyName         String   @unique // e.g., "GEMINI_API_KEY", "GEMINI_API_KEY_1"
  exhausted       Boolean  @default(false)
  exhaustedAt     DateTime?
  retryAfter      DateTime? // When to retry this key (based on API retry delay)
  lastError       String?  // Last error message
  lastErrorStatus Int?     // Last error status code
  successCount    Int      @default(0) // Track successful calls to reset exhausted state
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("gemini-api-key-states")
}

model UserNewsPreferences {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  topics    String[] @default(["AI", "Technology", "Investing", "Crypto", "Stocks"]) // Selected topic names
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user-news-preferences")
}

model FeatureRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  message   String
  email     String?  // optional for anonymous submitters
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("feature-requests")
}

model NewsletterSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  source    String?  @default("landing") // landing, widget, etc.
  createdAt DateTime @default(now())

  @@map("newsletter-subscriptions")
}

model CampaignAnalytics {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId          String   @db.ObjectId
  projectId           String   @db.ObjectId
  
  // Time period
  periodStart         DateTime
  periodEnd           DateTime
  calculatedAt        DateTime @default(now())
  
  // Overall metrics
  totalPosts          Int      @default(0)
  totalLikes          Int      @default(0)
  totalComments       Int      @default(0)
  totalShares         Int      @default(0)
  totalImpressions    Int      @default(0)
  avgEngagementRate   Float    @default(0)
  
  // Best performers
  bestPostingHour     Int?     // 0-23
  bestDayOfWeek       Int?     // 0-6 (Sunday-Saturday)
  bestPlatform        String?
  
  // Platform breakdown (JSON)
  platformMetrics     Json     @default("{}") // { "twitter": { likes: 100, ... }, "linkedin": {...} }
  
  // Content insights (JSON)
  contentPatterns     Json     @default("{}") // { "questionsPerformBetter": true, "optimalLength": 280, ... }
  
  createdAt           DateTime @default(now())
  
  campaign CampaignPlanner? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@map("campaign-analytics")
  @@index([campaignId])
  @@index([projectId])
}

model ProjectAnalytics {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId           String   @db.ObjectId
  
  // Time period
  periodStart         DateTime
  periodEnd           DateTime
  calculatedAt        DateTime @default(now())
  
  // Aggregated metrics
  totalPosts          Int      @default(0)
  totalCampaigns      Int      @default(0)
  avgEngagementRate   Float    @default(0)
  
  // Insights for new campaigns
  recommendedTime     String?  // "14:00"
  recommendedPlatforms String[] @default([])
  contentSuggestions  Json     @default("{}") // { "useQuestions": true, "optimalLength": 280, ... }
  
  // Trend analysis
  engagementTrend     String?  // "improving", "stable", "declining"
  
  // Campaign suggestions (JSON array)
  campaignSuggestions Json     @default("[]") // AI-generated campaign ideas
  
  createdAt           DateTime @default(now())
  
  project Projects? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("project-analytics")
  @@index([projectId])
}

model BrandDiscovery {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId             String   @db.ObjectId
  
  // Product Information
  brandName             String
  productDescription    String
  features              String[] @default([])
  heroPersona           String?
  benefits              String[] @default([])
  buyerQuestions        String[] @default([])
  
  // Competition
  competitors           String[] @default([])
  competitiveDiff       String?
  
  // Social Proof
  testimonials          String[] @default([])
  proofPoints           String[] @default([])
  
  // Customer Insights
  customerDescription   String?
  dreamOutcome          String?
  jobsToBeDone          String[] @default([])
  challenges            String[] @default([])
  emotionalBenefits     String[] @default([])
  transformations       String[] @default([])
  perceptions           String[] @default([])
  alternatives          String[] @default([])
  alternativesDiff      String?
  lifeEvents            String[] @default([])
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  adCreatives           AdCreative[]
  
  @@map("brand-discoveries")
  @@index([projectId])
}

model AdCreative {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  brandDiscoveryId      String   @db.ObjectId
  
  // Ad Details
  angle                 String   // e.g., "Social Proof", "Problem/Solution", etc.
  imageDescription      String
  imageCopy             String
  headline              String
  primaryText           String
  
  // Generated Image
  imageKey              String?  // R2 storage key for the generated ad image
  
  // Metadata
  platform              String   @default("facebook")
  status                String   @default("draft") // draft, active, paused
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  brandDiscovery        BrandDiscovery @relation(fields: [brandDiscoveryId], references: [id], onDelete: Cascade)
  
  @@map("ad-creatives")
  @@index([brandDiscoveryId])
  @@index([angle])
}

model PersonaDiscovery {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId             String   @db.ObjectId

  // Product / Service
  productName           String
  productDescription    String
  productCategory       String?
  priceRange            String?
  uniqueValue           String?

  // Current Customers
  currentCustomers      String?
  ageGroups             String[] @default([])
  genderSplit           String?
  topLocations          String[] @default([])
  occupations           String[] @default([])

  // Buying Behavior
  discoveryChannels     String[] @default([])
  purchaseTriggers      String[] @default([])
  commonObjections      String[] @default([])
  buyingCycleLength     String?

  // Goals & Pain Points
  customerGoals         String[] @default([])
  frustrations          String[] @default([])
  motivations           String[] @default([])
  fears                 String[] @default([])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  personaResults        PersonaResult[]

  @@map("persona-discoveries")
  @@index([projectId])
}

model PersonaResult {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  personaDiscoveryId    String   @db.ObjectId

  // Persona Identity
  personaName           String   // e.g., "The Busy Professional"
  tagline               String   // Short one-liner description
  avatar                String?  // Emoji or icon identifier

  // Demographics
  ageRange              String
  gender                String
  location              String
  incomeLevel           String
  education             String
  occupation            String

  // Psychographics
  values                String[] @default([])
  interests             String[] @default([])
  lifestyle             String

  // Behavioral
  goals                 String[] @default([])
  painPoints            String[] @default([])
  buyingMotivations     String[] @default([])
  preferredChannels     String[] @default([])
  contentPreferences    String[] @default([])

  // Messaging
  messagingAngles       String[] @default([])
  toneOfVoice           String
  keyMessages           String[] @default([])

  // Narrative
  dayInTheLife          String   // A narrative paragraph
  howProductFits        String   // How the product fits their life

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  personaDiscovery      PersonaDiscovery @relation(fields: [personaDiscoveryId], references: [id], onDelete: Cascade)

  @@map("persona-results")
  @@index([personaDiscoveryId])
}
